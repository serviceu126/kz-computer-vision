+"""
+Сервис отдачи MJPEG-потока камеры для киоска.
+
+Зачем это нужно:
+1) UI киоска должен получать поток по тому же домену/порту, что и основной сервер (8000),
+   иначе на другом ПК/планшете начинаются проблемы с 127.0.0.1, CORS и смешанными портами.
+2) Мы встраиваем поток как под-роутер в основной FastAPI (service/kiosk_api.py).
+
+Как работает:
+- Берём RTSP с камеры (через ffmpeg) и транслируем в MJPEG.
+- Отдаём как multipart/x-mixed-replace.
+
+Важно:
+- Код не трогает бизнес-логику таймера, событий и смен.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+from typing import Iterator
+
+from fastapi import APIRouter
+from fastapi.responses import StreamingResponse
+
+
+router = APIRouter(prefix="/camera", tags=["camera"])
+
+
+def _get_rtsp_url() -> str:
+    """
+    RTSP URL камеры.
+    Делаем через переменную окружения, чтобы не хардкодить пароли в коде.
+
+    По умолчанию оставляем IP камеры 192.168.31.64 (как используется в проекте).
+    """
+    return os.getenv(
+        "KZ_CAMERA_RTSP_URL",
+        "rtsp://admin:admin@192.168.31.64:554/Streaming/Channels/101",
+    )
+
+
+def _mjpeg_frames() -> Iterator[bytes]:
+    """
+    Генератор MJPEG-кадров.
+    Мы запускаем ffmpeg и читаем stdout как поток JPEG-фреймов.
+
+    Формат ответа: multipart/x-mixed-replace; boundary=frame
+    """
+    rtsp_url = _get_rtsp_url()
+
+    # ffmpeg отдает последовательность JPEG кадров в stdout.
+    # -loglevel error: меньше мусора в консоли
+    # -rtsp_transport tcp: стабильнее, чем udp, особенно в “шумных” сетях
+    cmd = [
+        "ffmpeg",
+        "-loglevel",
+        "error",
+        "-rtsp_transport",
+        "tcp",
+        "-i",
+        rtsp_url,
+        "-vf",
+        "fps=10",  # не перегружаем сеть/CPU
+        "-f",
+        "image2pipe",
+        "-vcodec",
+        "mjpeg",
+        "-",
+    ]
+
+    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+
+    if not proc.stdout:
+        raise RuntimeError("ffmpeg не смог открыть stdout для потока камеры")
+
+    boundary = b"--frame\r\nContent-Type: image/jpeg\r\n\r\n"
+    try:
+        # Читаем JPEG-кадры из пайпа.
+        # Важно: это упрощённый способ. Для нашего киоска достаточно.
+        buffer = b""
+        while True:
+            chunk = proc.stdout.read(4096)
+            if not chunk:
+                break
+            buffer += chunk
+
+            # JPEG заканчивается маркером FF D9
+            end = buffer.find(b"\xff\xd9")
+            if end == -1:
+                continue
+
+            frame = buffer[: end + 2]
+            buffer = buffer[end + 2 :]
+
+            yield boundary + frame + b"\r\n"
+    finally:
+        try:
+            proc.kill()
+        except Exception:
+            pass
+
+
+@router.get("/stream")
+def camera_stream():
+    """
+    MJPEG stream для киоска: /camera/stream
+    """
+    return StreamingResponse(
+        _mjpeg_frames(),
+        media_type="multipart/x-mixed-replace; boundary=frame",
+    )
+
